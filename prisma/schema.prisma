generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Operator {
  quickScore @map("quick-score")
  nlReview   @map("nl-review")
  teacher
  system
}

enum StudentRosterStatus {
  ACTIVE
  INACTIVE
}

enum DraftRecordKind {
  standard
  replacement
  correction
}

// 0. 学期班级（每个学期使用独立班级实体；同编号可跨学期复用）
model Class {
  id         String @id @default(cuid())
  semesterId String
  code       String   // 班级编号，如 "G3-01"；同一学期内唯一
  name       String?  // 班级名称，如 "高三(1)班"，可空

  semester      Semester                @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  enrollments   StudentClassEnrollment[]
  sessions      ClassSession[]
  feedbackPlans FeedbackPlan[]
  teacherTasks  TeacherTask[]
  classGroupMembership ClassGroupMembership?

  @@unique([semesterId, code])
  @@index([semesterId, name])
}

// 0b. 标签表（v0.13: 从 JSON 迁移为关联表）
model Label {
  id   String @id @default(cuid())
  name String @unique

  students StudentLabel[]
}

model StudentLabel {
  studentId String
  labelId   String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  label   Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([studentId, labelId])
  @@index([studentId])
  @@index([labelId])
}

// 1. 学生基础档案
model Student {
  id        String   @id @default(cuid())
  name      String
  studentId String   @unique
  gender    String   // "男" | "女"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments     StudentClassEnrollment[]
  studentLabels   StudentLabel[]
  sessionMetrics  SessionMetric[]
  events          Event[]
  communications  Communication[]
  attendances     Attendance[]
  teacherObservations TeacherObservation[]
  weComHandoffPackages WeComHandoffPackage[]
  feedbackPlanItems FeedbackPlanItem[]
  teacherTasks TeacherTask[]
  communicationPreference CommunicationPreference?
  communicationPreferenceCandidates CommunicationPreferenceCandidate[]

  @@index([studentId])
}

// 1b. 学生在某学期的唯一班级归属与名单状态
model StudentClassEnrollment {
  id               String              @id @default(cuid())
  studentId        String
  semesterId       String
  classId          String
  rosterStatus     StudentRosterStatus @default(ACTIVE)
  statusEffectiveAt DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  class    Class    @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@unique([studentId, semesterId])
  @@index([classId, rosterStatus])
  @@index([semesterId, rosterStatus])
}

// 2. 课次四维评分（每课次独立评分，sessionId 可空用于无课次场景）
model SessionMetric {
  id        String   @id @default(cuid())
  studentId String
  date      String   // YYYY-MM-DD，冗余字段（sessionId 可空时仍需直接绑定日期）
  scoreA    Int      // 0-5
  scoreB    Int      // 0-5
  scoreC    Int      // 0-5
  scoreD    Int      @default(3) // 0-5，考勤自动计算
  operator  Operator // v0.12: Prisma enum
  sessionId String?  // 关联课次（可空，NL输入等无课次场景为null）
  createdAt DateTime @default(now())

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session ClassSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
}

// 2b. 评分历史存档（更新前备份，追加不覆盖）
model SessionMetricHistory {
  id          String   @id @default(cuid())
  metricId    String   // 原 SessionMetric.id
  studentId   String
  date        String
  scoreA      Int
  scoreB      Int
  scoreC      Int
  scoreD      Int
  operator    Operator // v0.12: Prisma enum
  sessionId   String?
  archivedAt  DateTime @default(now())
  changeType  String   // "update" | "delete"

  @@index([studentId])
  @@index([metricId])
}

// 3. 关键事件记录（绑定课次，日期从 ClassSession.date 获取）
model Event {
  id          String   @id @default(cuid())
  studentId   String
  sessionId   String   // 关联课次（必填）
  type        String   // "课堂表现" | "测验成绩" | "心理状态" | "家校沟通"
  description String
  rawText     String   // 原始输入文本片段
  createdAt   DateTime @default(now())

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId, description])
}

// 4. 家校沟通记录（绑定课次）
model Communication {
  id        String   @id @default(cuid())
  studentId String
  sessionId String   // 关联课次（必填）
  target    String   // 沟通对象，如 "父亲"、"母亲"
  summary   String   // 内容摘要
  // 实际沟通发生日期或日期范围；空字符串表示旧数据没有可靠的发生时间。
  occurredAt String   @default("")
  sourceKey String?  @unique // 外部导入的稳定去重键；手工记录为 null
  createdAt DateTime @default(now())

  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  observationSources TeacherObservationSource[]
  drafts DraftRecord[]
  revisions CommunicationRevision[]

  @@unique([studentId, sessionId, summary, occurredAt])
}

// 4b. 企微增量处理账本（不复制原始聊天正文）
model WeComImportState {
  id                  String    @id
  initializedAfter    DateTime
  lastSucceededUntil  DateTime?
  activeRunId         String?
  activeRunStartedAt  DateTime?
  updatedAt           DateTime  @updatedAt
}

model WeComImportRun {
  id                 String   @id
  status             String   // running/complete/attention_required/failed/cancelled/interrupted/rolled_back
  windowStartedAt    DateTime
  windowEndedAt      DateTime
  conversationCount  Int      @default(0)
  messageCount       Int      @default(0)
  batchCount         Int      @default(0)
  communicationCount Int      @default(0)
  labelCount         Int      @default(0)
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  rolledBackAt       DateTime?
  cancelRequestedAt  DateTime?
  cancelMode         String?  // "stop" | "stop_and_rollback"

  operations WeComImportOperation[]

  @@index([status, startedAt])
}

model WeComImportOperation {
  id                 String   @id @default(cuid())
  runId              String
  batchKey           String
  conversationId     String
  conversationTitle  String
  status             String   // processing/complete/needs_review/failed/split/cancelled/interrupted/ignored/rolled_back
  messageCount       Int
  candidateStudentIds String   @default("[]")
  communicationCount Int      @default(0)
  labelCount         Int      @default(0)
  candidateJson      String?  // 仅用于失败恢复，成功入库后清空
  extractedAt        DateTime?
  attemptCount       Int      @default(0)
  failureCode        String?
  reviewReasonCodes  String?  // JSON array of non-sensitive reason codes
  modelName          String?
  finishReason       String?
  promptVersion      String?
  promptTokens       Int?
  reasoningTokens    Int?
  completionTokens   Int?
  responseCharacters Int?
  startedAt          DateTime @default(now())
  completedAt        DateTime?
  rolledBackAt       DateTime?

  run      WeComImportRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  receipts WeComMessageReceipt[]
  changes  WeComImportChange[]

  @@unique([runId, batchKey])
  @@index([runId, status])
  @@index([status, completedAt])
  @@index([conversationId])
}

model WeComMessageReceipt {
  messageId      String
  conversationId String
  sentAt         DateTime?
  contentHash    String
  status         String   // "pending" | "extracting" | "imported" | "no_value" | "needs_review" | "failed" | "ignored" | "rolled_back"
  promptVersion  String
  operationId    String?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  operation WeComImportOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@id([conversationId, messageId])
  @@index([conversationId, status])
  @@index([status, updatedAt])
}

// 回滚日志只记录本批新增实体的 ID，不存整库快照。
model WeComImportChange {
  id          String   @id @default(cuid())
  operationId String
  entityType  String   // "communication" | "student_label"
  entityId    String
  studentId   String?
  labelId     String?
  createdAt   DateTime @default(now())

  operation WeComImportOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@unique([operationId, entityType, entityId])
  @@index([operationId])
}

// 5. 待复核草案
model DraftRecord {
  id           String   @id @default(cuid())
  rawText      String
  parsedResult String   // JSON
  reviewResult String?  // JSON
  status       String   @default("pending") // "pending" | "confirmed" | "rejected" | "superseded"
  kind         DraftRecordKind @default(standard)
  sessionCode  String?  // v0.7: 关联课次编码（可选）
  studentId    String?  // v0.10: 解析时匹配到的 studentId
  supersedesDraftId String?
  communicationId String?
  handoffPackageId String?
  createdAt    DateTime @default(now())

  supersedesDraft DraftRecord? @relation("DraftSupersession", fields: [supersedesDraftId], references: [id], onDelete: SetNull)
  replacementDrafts DraftRecord[] @relation("DraftSupersession")
  communication Communication? @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  handoffPackage WeComHandoffPackage? @relation(fields: [handoffPackageId], references: [id], onDelete: SetNull)
  communicationRevisions CommunicationRevision[]

  @@index([supersedesDraftId])
  @@index([communicationId])
  @@index([handoffPackageId])
}

// 6. 学期
model Semester {
  id        String   @id @default(cuid())
  name      String   // "2024-2025学年第一学期"
  startDate String   // YYYY-MM-DD
  endDate   String   // YYYY-MM-DD
  createdAt DateTime @default(now())
  feedbackScriptLibraryName      String?
  feedbackScriptLibraryJson      String?
  feedbackScriptLibraryUpdatedAt DateTime?

  classes Class[]
  enrollments StudentClassEnrollment[]
  sessions ClassSession[]
  feedbackPlans FeedbackPlan[]
  feedbackPlanBatches FeedbackPlanBatch[]
  classGroups ClassGroup[]
}

// 7. 课次记录（v0.2 重构：编码体系 + 班级 + 学期序号）
model ClassSession {
  id             String   @id @default(cuid())
  code           String   @unique         // YYYYMMDDNN，全局唯一标识
  semesterId     String
  semesterNumber Int                       // 学期内序号（1,2,3...），增删后应用层重排
  date           String                    // YYYY-MM-DD，冗余，从 code 推导方便索引
  classId        String?                   // 班级 FK；null = 全校
  createdAt      DateTime @default(now())

  semester    Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  class       Class?           @relation(fields: [classId], references: [id], onDelete: Restrict)
  attendances Attendance[]
  sessionMetrics SessionMetric[]
  events         Event[]
  communications  Communication[]
  observationSources TeacherObservationSource[]
  feedbackPlans FeedbackPlan[] @relation("FeedbackPlanSession")
  feedbackPlanRangeStarts FeedbackPlan[] @relation("FeedbackPlanRangeStart")
  feedbackPlanRangeEnds FeedbackPlan[] @relation("FeedbackPlanRangeEnd")
  teacherTasks TeacherTask[] @relation("TeacherTaskDueSession")
  groupLessonSession GroupLessonSession?
}

// 7b. 同一学期内的平行班当前分组。一个班级只属于一个当前班级组；历史课次关联不随换组改写。
model ClassGroup {
  id         String   @id @default(cuid())
  semesterId String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  semester   Semester               @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  memberships ClassGroupMembership[]
  lessons     GroupLesson[]

  @@unique([semesterId, name])
  @@index([semesterId, updatedAt])
}

model ClassGroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  classId   String   @unique
  createdAt DateTime @default(now())

  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, classId])
  @@index([groupId])
}

// 7c. 共同课只承载公共教学材料和真实课次之间的教师确认关系。
model GroupLesson {
  id               String   @id @default(cuid())
  groupId          String
  title            String
  sequence         Int
  materialSnapshot String   @default("{}")
  revision         Int      @default(0)
  confirmedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  group        ClassGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  revisions    GroupLessonRevision[]
  sessionLinks GroupLessonSession[]

  @@unique([groupId, sequence])
  @@index([groupId, updatedAt])
}

model GroupLessonRevision {
  id               String   @id @default(cuid())
  groupLessonId    String
  revision         Int
  materialSnapshot String
  confirmedAt      DateTime @default(now())

  groupLesson GroupLesson @relation(fields: [groupLessonId], references: [id], onDelete: Cascade)
  feedbackPlanBatches FeedbackPlanBatch[]

  @@unique([groupLessonId, revision])
  @@index([groupLessonId, confirmedAt])
}

model GroupLessonSession {
  id                String   @id @default(cuid())
  groupLessonId     String
  sessionId         String   @unique
  syncStatus        String   // "synced" | "partially_synced" | "diverged" | "not_applicable"
  differenceSummary String?
  comparable        Boolean  @default(true)
  confirmedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  groupLesson GroupLesson @relation(fields: [groupLessonId], references: [id], onDelete: Cascade)
  session     ClassSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([groupLessonId, sessionId])
  @@index([groupLessonId, syncStatus])
}

// 9. 系统操作日志（v0.11）
model SystemLog {
  id         String   @id @default(cuid())
  action     String   // "score.updated" | "alert.triggered" | "student.deleted" | "session.created" | "session.deleted" | "data.exported"
  targetType String   // "Student" | "Session" | "Draft" | "Class" | "System"
  targetId   String?  // 关联实体 id
  targetName String?  // 冗余：便于前端不 join 就能展示
  detail     String   @default("{}") // JSON，存储变更前后值等详情
  createdAt  DateTime @default(now())
}

// 8. 考勤记录
model Attendance {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  present   Boolean  @default(true)
  createdAt DateTime @default(now())

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

// 10. 教师教学总结缓存（确定性事实实时计算，仅缓存结构化 LLM 解读）
model TeachingSummaryCache {
  id                    String   @id @default(cuid())
  scopeType             String   // "session" | "date"
  scopeKey              String
  includeCommunications Boolean
  sourceFingerprint     String
  resultJson            String
  promptVersion         String
  modelName             String
  generatedAt           DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([scopeType, scopeKey, includeCommunications])
  @@index([generatedAt])
}

// 12. 教师内部家校沟通观察待办；复核页教师观察不写入本表，而是沿用 Event(type="教师处理")
model TeacherObservation {
  id              String   @id @default(cuid())
  studentId       String
  kind            String
  topic           String
  title           String
  evidenceSummary String
  status          String   @default("new")
  analysisVersion String
  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())
  statusChangedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sources TeacherObservationSource[]

  @@unique([studentId, kind, topic])
  @@index([status, lastDetectedAt])
  @@index([studentId])
}

model TeacherObservationSource {
  observationId   String
  communicationId String
  relatedSessionId String?
  createdAt       DateTime @default(now())

  observation   TeacherObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  communication Communication      @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  relatedSession ClassSession?      @relation(fields: [relatedSessionId], references: [id], onDelete: SetNull)

  @@id([observationId, communicationId])
  @@index([communicationId])
  @@index([relatedSessionId])
}

// 12b. 成功的业务级 LLM 生成记录。热数据保留完整业务快照；压缩后只留审计摘要。
// 不保存供应商原始响应、思维内容、凭据或 WCC 原始聊天。
model GenerationRecord {
  id                String   @id @default(cuid())
  taskType          String   // "feedback" | "teaching-summary" | "classroom-parse" | "wecom-*"
  stage             String   // "routine" | "draft" | "review" | "interpretation" | "parse" | "extraction"
  lifecycle         String   @default("hot") // "hot" | "warm" | "purged"
  semesterId        String?
  classId           String?
  sessionId         String?
  studentId         String?
  operationKey      String?
  sourceRefs        String   @default("[]") // JSON；只保存内部业务 ID 与类型
  sourceFingerprint String
  promptVersion     String
  modelName         String
  modelRole         String?
  modelProfileId    String?
  modelSettings     String   @default("{}") // JSON；不保存 endpoint 或凭据
  inputRevision     String?
  parentGenerationId String?
  feedbackPlanItemId String?
  variantKey        String?  @unique
  inputSnapshot     String?  // JSON；仅热数据
  outputSnapshot    String?  // JSON；仅热数据
  finalText         String?  // 仅热数据；教师采纳后更新
  warmSnapshot      String?  // JSON；不可全盘复原的学期快照
  generatedAt       DateTime @default(now())
  adoptedAt         DateTime?
  compactedAt       DateTime?
  purgedAt          DateTime?
  staleAt           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  parentGeneration  GenerationRecord?  @relation("GenerationVariants", fields: [parentGenerationId], references: [id], onDelete: SetNull)
  derivedGenerations GenerationRecord[] @relation("GenerationVariants")
  feedbackPlanItem   FeedbackPlanItem? @relation("FeedbackPlanItemGenerations", fields: [feedbackPlanItemId], references: [id], onDelete: SetNull)
  selectedPlanItems  FeedbackPlanItem[] @relation("FeedbackPlanItemSelectedGeneration")

  @@index([lifecycle, generatedAt])
  @@index([semesterId, classId, sessionId])
  @@index([studentId, lifecycle])
  @@index([taskType, generatedAt])
  @@index([parentGenerationId])
  @@index([inputRevision])
  @@index([feedbackPlanItemId])
}

// 12c. 反馈计划：统一承载班级公共、事件微反馈、阶段趋势和结课教学总结。
// 业务快照使用版本化 JSON，最终批准文本和导出状态独立于模型原始输出。
model FeedbackPlan {
  id                  String   @id @default(cuid())
  type                String   // "class_update" | "event_micro" | "stage_trend" | "course_end"
  outputRequirement   String
  status              String   @default("draft")
  semesterId          String
  classId             String
  sessionId           String?
  rangeStartSessionId String?
  rangeEndSessionId   String?
  inputFingerprint    String
  inputSnapshot       String   @default("{}") // 版本化课程材料与计划输入快照
  generationMode      String   @default("standard") // "standard" | "fast"
  generationStartedAt DateTime?
  generationCompletedAt DateTime?
  generationElapsedMs Int      @default(0)
  generationRunStartedAt DateTime?
  planRevision        Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  approvedAt          DateTime?
  exportedAt          DateTime?
  archivedAt          DateTime?
  batchId             String?
  batchOrder          Int?

  semester          Semester      @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  class             Class          @relation(fields: [classId], references: [id], onDelete: Restrict)
  session           ClassSession? @relation("FeedbackPlanSession", fields: [sessionId], references: [id], onDelete: SetNull)
  rangeStartSession ClassSession? @relation("FeedbackPlanRangeStart", fields: [rangeStartSessionId], references: [id], onDelete: SetNull)
  rangeEndSession   ClassSession? @relation("FeedbackPlanRangeEnd", fields: [rangeEndSessionId], references: [id], onDelete: SetNull)
  items             FeedbackPlanItem[]
  tasks             TeacherTask[]
  attachments       FeedbackAttachment[]
  exportRuns        FeedbackExportRun[]
  batch             FeedbackPlanBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([batchId, batchOrder])
  @@unique([batchId, classId])
  @@index([classId, semesterId, archivedAt, updatedAt])
  @@index([classId, semesterId, type, createdAt])
  @@index([status, updatedAt])
}

// 12d.1 多班反馈批次只编排既有 FeedbackPlan；每班仍是独立计划和审核边界。
model FeedbackPlanBatch {
  id                     String   @id @default(cuid())
  requestKey             String   @unique
  semesterId             String
  type                   String   // "event_micro" | "stage_trend"
  outputRequirement      String
  generationMode         String   @default("standard")
  status                 String   @default("ready")
  currentPlanId          String?
  failedPlanId           String?
  sharedLessonRevisionId String?
  planRevision           Int      @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  archivedAt             DateTime?

  semester             Semester             @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sharedLessonRevision GroupLessonRevision? @relation(fields: [sharedLessonRevisionId], references: [id], onDelete: SetNull)
  plans                 FeedbackPlan[]
  exportRuns            FeedbackPlanBatchExportRun[]

  @@index([semesterId, archivedAt, updatedAt])
  @@index([status, updatedAt])
}

model FeedbackPlanItem {
  id                   String   @id @default(cuid())
  planId               String
  studentId            String?
  status               String   @default("evidence_ready")
  generationError      String?
  generationConfigSnapshot String  @default("{}") // 版本化学生独立反馈计划配置；空对象表示沿用批次公共配置
  evidenceSnapshot     String   @default("{}")
  compositionSnapshot  String   @default("{}")
  auditSnapshot        String   @default("{}")
  finalText            String?
  finalTextHash        String?
  selectedGenerationId String?
  reviewMode           String   @default("model") // "model" | "teacher_edited"
  generationStartedAt  DateTime?
  generationCompletedAt DateTime?
  generationDurationMs Int?
  itemRevision         Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  approvedAt           DateTime?
  exportedAt           DateTime?

  plan              FeedbackPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  student           Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  selectedGeneration GenerationRecord? @relation("FeedbackPlanItemSelectedGeneration", fields: [selectedGenerationId], references: [id], onDelete: SetNull)
  generations       GenerationRecord[] @relation("FeedbackPlanItemGenerations")
  tasks             TeacherTask[]
  attachments       FeedbackAttachment[]

  @@unique([planId, studentId])
  @@index([studentId, status])
  @@index([selectedGenerationId])
}

model TeacherTask {
  id               String   @id @default(cuid())
  planId           String
  planItemId       String?
  studentId        String?
  classId          String
  action           String
  promiseExcerpt   String?
  dueType          String   // "date" | "session"
  dueDate          String?
  dueSessionId     String?
  estimatedMinutes Int?
  status           String   @default("pending")
  sourceHash       String?
  createdAt        DateTime @default(now())
  approvedAt       DateTime?
  completedAt      DateTime?
  updatedAt        DateTime @updatedAt

  plan       FeedbackPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  planItem   FeedbackPlanItem?  @relation(fields: [planItemId], references: [id], onDelete: SetNull)
  student    Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class              @relation(fields: [classId], references: [id], onDelete: Restrict)
  dueSession ClassSession?      @relation("TeacherTaskDueSession", fields: [dueSessionId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([status, dueSessionId])
  @@index([studentId, status])
}

model CommunicationPreference {
  id                 String   @id @default(cuid())
  studentId          String   @unique
  preferenceSnapshot String   @default("{}")
  sourceCandidateId  String?  @unique
  confirmedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student         Student                           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourceCandidate CommunicationPreferenceCandidate? @relation("PreferenceSourceCandidate", fields: [sourceCandidateId], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model CommunicationPreferenceCandidate {
  id                 String   @id @default(cuid())
  studentId          String
  sourceType         String   // "communication" | "teacher"
  sourceId           String?
  preferenceSnapshot String   @default("{}")
  evidenceSnapshot   String   @default("{}")
  status             String   @default("pending")
  createdAt          DateTime @default(now())
  reviewedAt         DateTime?

  student          Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activePreference CommunicationPreference? @relation("PreferenceSourceCandidate")

  @@index([studentId, status, createdAt])
}

model FeedbackAttachment {
  id              String   @id @default(cuid())
  planId          String
  planItemId      String?
  displayName     String
  mimeType        String
  sizeBytes       Int
  sha256          String
  relativeLocator String
  status          String   @default("available") // "available" | "missing" | "deleted"
  createdAt       DateTime @default(now())
  deletedAt       DateTime?

  plan     FeedbackPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  planItem FeedbackPlanItem?  @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  @@index([planId, status])
  @@index([sha256])
}

model FeedbackExportRun {
  id           String   @id @default(cuid())
  planId       String
  mode         String   // "complete" | "approved_only"
  itemManifest String   @default("[]")
  manifestHash String
  isRepeat     Boolean  @default(false)
  batchExportRunId String?
  createdAt    DateTime @default(now())

  plan FeedbackPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  batchExportRun FeedbackPlanBatchExportRun? @relation(fields: [batchExportRunId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
  @@index([batchExportRunId])
}

model FeedbackPlanBatchExportRun {
  id             String   @id @default(cuid())
  batchId        String
  mode           String   // "complete" | "approved_only"
  itemManifest   String   @default("[]")
  manifestHash   String
  workbookSha256 String
  isRepeat       Boolean  @default(false)
  createdAt      DateTime @default(now())

  batch     FeedbackPlanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  childRuns FeedbackExportRun[]

  @@index([batchId, createdAt])
}

// 12e. 面向后续教学的受控记忆。semesterKey 为学期 ID 或 "long-term"，避免 nullable 唯一键歧义。
model TeachingMemory {
  id                String   @id @default(cuid())
  scopeType         String   // "student" | "class"
  scopeId           String
  semesterKey       String
  semesterId        String?
  memoryTier        String   // "semester" | "long-term"
  status            String   @default("confirmed") // "draft" | "confirmed" | "superseded" | "stale"
  content           String   // JSON（semester）或短文本（long-term）
  sourceRefs        String   @default("[]")
  sourceFingerprint String
  effectiveThrough  String?
  generatedAt       DateTime @default(now())
  confirmedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([scopeType, scopeId, semesterKey, memoryTier])
  @@index([scopeType, scopeId, status])
  @@index([semesterId, memoryTier])
}

// 12e. 热/温/长期记忆压缩账本。回滚数据只在短期撤销窗口内存在。
model MemoryCompactionRun {
  id              String   @id @default(cuid())
  classId         String
  semesterId      String?
  fromSessionId   String?
  toSessionId     String?
  phase           String   // "hot-to-warm" | "warm-to-long"
  status          String   @default("pending") // "pending" | "running" | "succeeded" | "failed" | "undone"
  sourceFingerprint String
  affectedCount   Int      @default(0)
  resultJson      String?
  rollbackPayload String?
  undoUntil       DateTime?
  failureCode     String?
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([classId, phase, sourceFingerprint])
  @@index([status, createdAt])
  @@index([classId, phase, completedAt])
}

// 13. WCC 本地转交包账本；只存包标识、哈希和处理状态，不复制聊天正文。
model WeComHandoffPackage {
  id                String   @id @default(cuid())
  sourceId          String
  conversationId    String?
  packageId         String
  packageSha256     String
  status            String
  outcome           String?
  code              String?
  messageCount      Int
  selectedStudentId String?
  rootPackageId     String?
  parentPackageId   String?
  revisionNumber    Int      @default(1)
  receiptId         String?
  producedAt        DateTime
  firstSeenAt       DateTime @default(now())
  lastAttemptAt     DateTime?
  processedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  selectedStudent Student? @relation(fields: [selectedStudentId], references: [id], onDelete: SetNull)
  drafts DraftRecord[]
  communicationRevisions CommunicationRevision[]

  @@unique([sourceId, packageId, packageSha256])
  @@index([sourceId, packageId])
  @@index([sourceId, conversationId])
  @@index([status, updatedAt])
  @@index([selectedStudentId])
  @@index([rootPackageId, revisionNumber])
  @@index([parentPackageId])
}

model CommunicationRevision {
  id                   String   @id @default(cuid())
  communicationId      String
  draftId              String?
  handoffPackageId     String?
  previousTarget       String
  nextTarget           String
  previousSummary      String
  nextSummary          String
  previousOccurredAt   String?
  nextOccurredAt       String?
  previousSessionId    String
  nextSessionId        String
  confirmedAt          DateTime @default(now())
  createdAt            DateTime @default(now())

  communication  Communication       @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  draft          DraftRecord?         @relation(fields: [draftId], references: [id], onDelete: SetNull)
  handoffPackage WeComHandoffPackage? @relation(fields: [handoffPackageId], references: [id], onDelete: SetNull)

  @@unique([communicationId, draftId])
  @@index([communicationId, confirmedAt])
  @@index([handoffPackageId])
}
