{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://student-track.local/contracts/wcc-student-track-file-v1.schema.json",
  "title": "WCC to Student Track local handoff package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "packageId", "producedAt", "producer", "source",
    "conversation", "timeRange", "completeness", "classification", "messages",
    "sourceFingerprint"
  ],
  "properties": {
    "contractVersion": { "const": "wcc.student-track-file.v1" },
    "packageId": { "$ref": "#/$defs/id" },
    "producedAt": { "$ref": "#/$defs/timestamp" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "wecomcatch" },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "watermark"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "watermark": { "type": "integer", "minimum": 0 }
      }
    },
    "conversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "maxLength": 300 }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "end": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "timezone": { "const": "Asia/Shanghai" }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveStatus", "sourceMessageCount"],
      "properties": {
        "archiveStatus": { "type": "string", "minLength": 1, "maxLength": 80 },
        "sourceMessageCount": { "type": "integer", "minimum": 0 }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worthProcessing", "decision", "reasons", "classifier"],
      "properties": {
        "worthProcessing": { "type": "boolean" },
        "decision": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reasons": {
          "type": "array", "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "classifier": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "sender": { "type": ["string", "null"], "maxLength": 200 },
          "direction": { "type": ["string", "null"], "maxLength": 40 },
          "sentAt": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
          "timeContext": { "type": ["string", "null"], "maxLength": 120 },
          "type": { "type": ["string", "null"], "maxLength": 80 },
          "content": { "type": "string", "minLength": 1, "maxLength": 20000 },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "sourceFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "timestamp": { "type": "string", "format": "date-time", "maxLength": 40 }
  }
}
