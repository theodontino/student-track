DATABASE_URL="file:./dev.db"

# LLM API 配置（使用前填入真实 Key）
LLM_API_KEY="sk-your-api-key-here"
LLM_API_BASE_URL="https://api.deepseek.com"
WECOMCATCH_API_TOKEN="replace-with-a-long-random-local-token"
LLM_MODEL="deepseek-v4-flash"

# 本地音频转写工具（可选，未配置时使用 ~/tools/funasr-diarize）
STUDENT_TRACK_DIARIZE_TOOL_DIR="/absolute/path/to/funasr-diarize"

# WCC → Student Track 本地中转目录；两端必须指向同一目录。
# 未配置时默认使用 ~/Library/Application Support/WCC Student Track Exchange
# STUDENT_TRACK_WCC_EXCHANGE_ROOT="/absolute/path/to/wcc-student-track-exchange"
