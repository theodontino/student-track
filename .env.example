DATABASE_URL="file:./dev.db"

# LLM API 配置（使用前填入真实 Key）
LLM_API_KEY="sk-your-api-key-here"
LLM_API_BASE_URL="https://api.deepseek.com"
WECOMCATCH_API_TOKEN="replace-with-a-long-random-local-token"
LLM_MODEL="deepseek-v4-flash"

# 本地音频转写工具（可选，未配置时使用 ~/tools/funasr-diarize）
STUDENT_TRACK_DIARIZE_TOOL_DIR="/absolute/path/to/funasr-diarize"

# 出门测 PDF 文字提取（可选；默认从 PATH 查找 pdftotext）
# STUDENT_TRACK_PDFTOTEXT_PATH="/absolute/path/to/pdftotext"

# 仓库外的可选 WeComCatch 工具；源码和运行数据不属于 Student Track。
# 可配置项目根目录，或只配置 CLI 的绝对路径。
WECOMCATCH_PROJECT_ROOT="/absolute/path/to/wecomcatch"
# WECOMCATCH_CLI_PATH="/absolute/path/to/wecomcatch/bin/wecomcatch"
WECOMCATCH_RUNTIME_DIR="/absolute/path/to/wecomcatch/runtime"
WECOMCATCH_CONFIG_PATH="/absolute/path/to/wecomcatch/config.local.json"
# WECOMCATCH_BUILD_DIR="/absolute/path/to/wecomcatch/build"

# WCC → Student Track 本地中转目录；两端必须指向同一目录。
# 未配置时默认使用 ~/Library/Application Support/WCC Student Track Exchange
# STUDENT_TRACK_WCC_EXCHANGE_ROOT="/absolute/path/to/wcc-student-track-exchange"
